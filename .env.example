# MySQL / MariaDB (XAMPP) Connection Settings
# Leave DB_HOST empty in AI Studio preview to use the built-in local SQLite fallback
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cics_inventory

# Server & Security
PORT=3000
JWT_SECRET=change_this_to_a_long_random_secret_in_production
ALLOWED_ORIGIN=

# Optional HTTPS on LAN (for camera QR scanning on phones over 192.168.x.x)
HTTPS_ENABLED=false
SSL_KEY_PATH=./certs/lan-key.pem
SSL_CERT_PATH=./certs/lan-cert.pem

# Platform variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
